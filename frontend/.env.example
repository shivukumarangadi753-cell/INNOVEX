# ==========================================
# PRAKRITI-NETRA Frontend Environment Configuration
# ==========================================

# API URL for PRAKRITI-NETRA backend
VITE_API_URL=http://localhost:8000

# Set to true to use standalone mock fixtures without requiring backend
VITE_USE_MOCK=false

# 1. Global Forest Watch (GFW Data API)
# Register at https://gfw-api.org or https://www.globalforestwatch.org
VITE_GFW_API_KEY=

# 2. Copernicus Open Access / Data Space Ecosystem (Sentinel-2)
# Register at https://dataspace.copernicus.eu
VITE_COPERNICUS_CLIENT_ID=
VITE_COPERNICUS_CLIENT_SECRET=

# 3. ISRO Bhuvan WMS Gateway
VITE_BHUVAN_WMS_URL=https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms

# 4. India-WRIS (Water Resources Information System)
# Register at https://indiawris.gov.in
VITE_INDIAWRIS_API_KEY=

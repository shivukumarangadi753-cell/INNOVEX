# ==========================================
# PRAKRITI-NETRA Environment Configuration
# ==========================================

# Data Mode: 'demo' (mock/synthetic telemetry) or 'live' (real satellite feed)
DATA_MODE=demo

# Telegram Bot integration for field alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NASA FIRMS API Map Key for active fire hotspots
FIRMS_MAP_KEY=

# Copernicus Data Space Ecosystem credentials for Sentinel imagery
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Frontend environment variables
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK=true

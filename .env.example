# Environment Configuration for Prakriti-Netra
# Copy this file to .env and adjust variables as required.

# Operational mode: "demo" (deterministic offline data) or "live" (connect to live satellite adapters)
DATA_MODE=demo

# Telegram Alert Notification Service
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NASA FIRMS VIIRS Active Fire Map API Key
FIRMS_MAP_KEY=

# Copernicus Data Space Ecosystem (openEO / Sentinel-2 NDWI)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# India-WRIS / Central Ground Water Board (optional live telemetry)
INDIAWRIS_API_KEY=

# Lake drying early warning threshold percentage (default 15.0%)
LAKE_WARNING_DROP_PCT=15.0

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK=false
